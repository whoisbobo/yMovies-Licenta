// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  movie
  tv
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  username             String          @unique
  displayName          String?
  bio                  String?
  location             String?
  website              String?
  favoriteGenres       String[]        @default([])
  avatarUrl            String?
  role                 Role            @default(USER)
  createdAt            DateTime        @default(now())

  isPremium            Boolean         @default(false)
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique

  reviews              Review[]
  ratings              Rating[]
  watchlist            WatchlistItem[]
  favorites            Favorite[]
  watched              Watched[]
  likes                Like[]
  reviewComments       ReviewComment[]
  reviewLikes          ReviewLike[]

  // Graf social: "following" = userii pe care îi urmărește; "followers" = cei care îl urmăresc.
  following            Follow[]        @relation("Following")
  followers            Follow[]        @relation("Followers")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model WatchlistItem {
  id        String    @id @default(uuid())
  userId    String
  movieId   Int
  mediaType MediaType @default(movie)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([userId, movieId, mediaType])
}

// Sloturi fixe "Favorite Films" (gen Letterboxd) — position 0..3, alese manual
// din Account Settings, nu printr-un toggle nelimitat pe pagina filmului.
model Favorite {
  id        String    @id @default(uuid())
  userId    String
  movieId   Int
  mediaType MediaType @default(movie)
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([userId, movieId, mediaType])
  @@unique([userId, position])
}

// Marcaj rapid "am văzut deja" — independent de recenzie (poți marca fără să scrii notă/comentariu)
model Watched {
  id        String    @id @default(uuid())
  userId    String
  movieId   Int
  mediaType MediaType @default(movie)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([userId, movieId, mediaType])
}

// Thumbs-up rapid — independent de nota din recenzie
model Like {
  id        String    @id @default(uuid())
  userId    String
  movieId   Int
  mediaType MediaType @default(movie)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([userId, movieId, mediaType])
}

model Movie {
  id        Int
  mediaType MediaType
  title     String

  reviews   Review[]
  ratings   Rating[]
  watchlist WatchlistItem[]
  favorites Favorite[]
  watched   Watched[]
  likes     Like[]

  // Cheia primară compusă
  @@id([id, mediaType])
}

// Notă (1-10, afișată ca 0.5-5.0 stele) — complet separată de Review.
// Poți nota un film fără să scrii recenzie, și invers.
model Rating {
  id        String    @id @default(uuid())
  userId    String
  movieId   Int
  mediaType MediaType @default(movie)
  value     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId, mediaType], references: [id, mediaType], onDelete: Cascade)

  @@unique([userId, movieId, mediaType])
  @@index([movieId, mediaType])
}

model PageCache {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Review {
  id         Int       @id @default(autoincrement())
  comment    String?
  hasSpoiler Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieId   Int
  mediaType MediaType @default(movie)
  movie     Movie     @relation(fields: [movieId, mediaType], references: [id, mediaType], onDelete: Cascade)

  comments  ReviewComment[]
  likes     ReviewLike[]

  @@unique([userId, movieId, mediaType])
  @@index([movieId, mediaType])
}

// Comentarii pe o recenzie (thread de discuție sub recenzie).
model ReviewComment {
  id        String   @id @default(uuid())
  reviewId  Int
  userId    String
  text      String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// Like-uri pe o recenzie (distinct de like-ul pe film).
model ReviewLike {
  id        String   @id @default(uuid())
  reviewId  Int
  userId    String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}